{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tarkor",
  "version": "0.1.0",
  "identifier": "io.github.zeldris.tarkor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "principal",
        "title": "Tarkor",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "category": "RolePlaying",
    "shortDescription": "RPG narrativo con IA local",
    "longDescription": "Tarkor es un juego de rol narrativo por texto ambientado en Helek Sirik. La narración la genera una IA que se ejecuta entera en tu equipo.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": { "section": "games" }
    }
  }
}
