#!/usr/bin/env bash
# galivelop-workflow v0.6.0
# Git pre-push hook (copied into projects as .githooks/pre-push; enable with: git config core.hooksPath .githooks).
#   - While it runs, keeps a marker `gw-push-in-progress.<pid>` in this worktree's own git dir (one per linked worktree, one per push) with its pid
#     and, per pushed ref, the LOCAL sha and local branch, so the Stop hook (before-stop.py) does not tell an agent to
#     push again while this one is still checking that very commit. Best effort and silent: it never makes the push fail; removed on every exit (only while
#     it still holds this hook's pid).
#   - Says which commits each ref pushes, or that it pushes nothing new.
#   - Refuses conflict markers and added *.rej / *.orig files in what is pushed (to the protected branch, in all it
#     gains from the remote tip, commits other branches already have included).
#   - Runs scripts/private-check.py (when the project has it) on the commits each ref pushes: key formats, e-mail
#     addresses not allowed and the private names of the local .claude/gw.local.json, in their added lines, added
#     paths and messages; privateCheck: false in the pushed commit's config turns it off. Fails closed. A refusal says
#     those commits are not pushed yet and gives the command that fixes only them (git commit --amend, or
#     git rebase -i <base>).
#   - Reads .claude/gw.json as each pushed commit has it (never the working tree's); a pushed commit without a valid
#     one is refused.
#   - Runs every `check` command of that config on the commit being pushed (a temporary worktree when it is not
#     the clean working copy), with GW_PUSH_PROTECTED=true when it goes to the protected branch (false otherwise).
#     D49: to another branch, with branchCheck `related` (the default), only relatedTests run, unless the ref's new
#     commits change a fullCheckPaths path or a key of .claude/gw.json outside fullCheckSkipKeys (E47), or
#     relatedTests has no command (config.py push-scope).
#     `checkWrapper` prefixes each command (`<wrapper> bash -c '<command>'`). The worktree lives in a per-repo folder
#     under ${TMPDIR:-/tmp} (or under `worktreeDir`), never inside .git/ (jest and others ignore any /.git/ path),
#     gets the `worktreeLinks` paths symlinked from the main checkout, and is removed on every exit (also on
#     Ctrl-C or kill; one left by a hard kill is removed by a later push once it is over 24 h old and its pid is
#     gone). Each command logs to its own mktemp file, kept only when it fails.
#   - Skips that `check` when the same tree already passed it with the same commands and wrapper less than 24 h ago
#     (a push that is not to the protected branch only; scripts/check-green.sh keeps the record in the git common dir,
#     scripts/check.sh writes it, and a green push records it). Protected pushes never read nor write it; if the helper
#     is missing or fails the check just runs. GW_CHECK_CACHE=0 git push runs it anyway.
#   - Also skips it (same conditions, `checkReuseMark` on) for a commit whose single parent's tree is recorded green and
#     whose diff from that parent is only the `reviewMark` file added or edited (no other path, no mode change, no
#     delete or rename): the mark commit of scripts/reviewed.sh. And one `git push` of the same tree to the protected
#     branch and to another branch runs the full check once, with the protected branch's (stricter) run (the branch still
#     gets its own scope: related tests). The cache is read again after waiting for the check lock.
#   - To the protected branch, in both pushToProtected modes (with `pr` the PR hook also guards PRs): code needs the
#     review mark (scripts/reviewed.sh) to name an ancestor with no code after it. The branch is protected when the
#     pushed commit, the remote tip or the working tree names it so; what is content and where the mark lives come
#     from the remote tip's config, so a commit cannot relax the rule that judges it (only a protected branch without
#     a config yet takes the pushed commit's, with a warning). Fails closed when a commit is missing (shallow clones
#     included).
#   - Calls related-tests.sh <changed-file> <checkout-dir> for each ref that takes the related scope (that ref's own
#     files, the folder where its commit is checked out); a ref that takes the full scope is covered by the call after
#     the loop, with those refs' files and the last checkout (with the check cached green on every such ref, only the slow ones). prepush-branches.sh <changed-file> <pushed-file> gets every
#     ref's files. Both come from the workflow's scripts folder whenever they exist (run with bash, executable or not),
#     with git's ref lines on stdin.
# Skipping it (git push --no-verify) is only for a WIP: commit with red tests.
# Bash 3.2 compatible. Root from this hook's path, never from $CLAUDE_PROJECT_DIR or the current directory.
set -uo pipefail
zero=0000000000000000000000000000000000000000
remote="${1:-origin}"

# Git's ref lines come on stdin: save them before anything else can read it.
work="$(mktemp -d "${TMPDIR:-/tmp}/gw-pre-push.XXXXXX")" || { echo "pre-push: cannot create a temp dir; free space in ${TMPDIR:-/tmp} and retry: git push" >&2; exit 1; }
worktree=""
log=""  # the temp log of the check commands (the lock names it); removed on any exit
checklock=""  # 1 while this hook holds the check lock (<git common dir>/gw/check.lock, shared with scripts/check.sh)
pushmark=""  # <this worktree's git dir>/gw-push-in-progress.<pid of this hook>: line 1 the pid of this hook, then one "<local sha> <branch>" line per ref pushed
cleanup() {
  # The marker name holds this hook's pid, so no other push ever rewrites it.
  if [ -n "$pushmark" ]; then rm -f "$pushmark" 2>/dev/null; fi
  if [ -n "$checklock" ]; then bash "$scripts/check-green.sh" lock-release "$$" < /dev/null 2>/dev/null; fi
  if [ -n "$log" ]; then rm -f "$log" 2>/dev/null; fi
  if [ -n "$worktree" ]; then git -C "$root" worktree remove --force "$worktree" >/dev/null 2>&1; rm -rf "$worktree" "${worktree%.d}"; fi
  rm -rf "$work"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
cat > "$work/input"
: > "$work/changed"
: > "$work/pushed"
: > "$work/changed_full"
full_runs=0    # full-scope refs whose check ran or was looked up (run_checks calls)
cache_hits=0   # of those, the ones the cache said were already green: their related tests are covered too (B33)
full_ref=false  # some ref took the full scope: the related tests after the loop run (fast ones even with no files)

unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE  # git sets GIT_DIR in linked worktrees: toplevel would be the cwd
# The git dir of the worktree that pushes, taken where git runs the hook (its top level), not from the hook's path:
# with an absolute core.hooksPath the hook file belongs to another worktree.
pushgit="$(git rev-parse --absolute-git-dir 2>/dev/null)" || pushgit=""
hookdir="$(cd "$(dirname "$0")" && pwd)"
root="$(git -C "$hookdir" rev-parse --show-toplevel 2>/dev/null)" || {
  echo "pre-push: $hookdir is not inside a git work tree; point git at the project's hooks: git config core.hooksPath .githooks" >&2; exit 1; }
cd "$root" || exit 1
{  # best effort: any failure here is silent and leaves the push untouched
  gitcommon="$pushgit"  # per worktree: linked worktrees must not share one marker
  if [ -n "$gitcommon" ]; then
    pushed_to="$(awk '$2 !~ /^0+$/ { sub(/^refs\/heads\//, "", $1); print $2, $1 }' "$work/input" 2>/dev/null)"
    if printf '%s\n%s\n' "$$" "$pushed_to" > "$gitcommon/gw-push-tmp.$$" \
        && mv -f "$gitcommon/gw-push-tmp.$$" "$gitcommon/gw-push-in-progress.$$"; then
      pushmark="$gitcommon/gw-push-in-progress.$$"
    else
      rm -f "$gitcommon/gw-push-tmp.$$"
    fi
  fi
} >/dev/null 2>&1
if [ -d "$root/.claude/gw/scripts" ]; then scripts="$root/.claude/gw/scripts"; else scripts="$root/scripts"; fi
config="$scripts/config.py"
fail() {  # fail <message lines...>: the last line is the command that fixes it
  for line in "$@"; do echo "pre-push: $line" >&2; done
  echo "pre-push: (only a WIP: commit may skip this hook: git push --no-verify)" >&2
  exit 1
}
cfg_at() {  # cfg_at <sha> <key> [<paths-sha>]: the key as commit <sha>'s .claude/gw.json has it (the pushed one or the
  # remote tip); an absent path key falls back to the old name if that exists in <paths-sha> (the commit pushed)
  python3 "$config" --root "$root" --rev "$1" --paths-at "${3:-$1}" get "$2" \
    || fail "cannot read '$2' from .claude/gw.json in commit ${1:0:7}; commit a valid one and push again: python3 $config --root $root --rev ${1:0:7} validate"
}
[ -f "$config" ] || fail "the workflow scripts are missing ($config); reinstall them: /gw-update"
protected=""
shallow="$(git rev-parse --is-shallow-repository 2>/dev/null || echo false)"
fetch_hint() {
  if [ "$shallow" = "true" ]; then echo "git fetch --deepen=200 $remote $protected"; else echo "git fetch $remote $protected"; fi
}

gwdir=""  # <worktreeDir or ${TMPDIR:-/tmp}>/gw-pre-push-wt-<uid>-<repo id>: where the temporary worktrees live
stale_worktrees() {  # remove worktrees an interrupted push (kill -9, power cut) left behind; a live push's stay
  local m pid err  # each push owns a marker file wt.XXXXXX holding its pid; its worktree is wt.XXXXXX.d
  for m in "$gwdir"/wt.*.d; do  # a worktree whose marker is gone is an orphan too
    [ -d "$m" ] && [ ! -e "${m%.d}" ] && { git worktree remove --force "$m" >/dev/null 2>&1; rm -rf "$m"; }
  done
  for m in "$gwdir"/wt.*; do
    [ -f "$m" ] || continue
    pid="$(cat "$m" 2>/dev/null)"
    [ -n "$pid" ] || continue  # empty: that push has made its marker but not written its pid yet
    case "$pid" in *[!0-9]*) pid="" ;; esac
    if [ -n "$pid" ]; then
      err="$(LC_ALL=C kill -0 "$pid" 2>&1)" && continue
      case "$err" in *"No such process"*) ;; *) continue ;; esac  # EPERM (another user's process) is alive too
    fi
    # A push from another pid namespace (a container or sandbox sharing the folder) looks dead from here: only a
    # marker over 24 h old is an orphan (find -mmin works on GNU and BSD).
    [ -n "$(find "$m" -prune -mmin +1440 2>/dev/null)" ] || continue
    git worktree remove --force "$m.d" >/dev/null 2>&1; rm -rf "$m.d" "$m"
  done
}
link_shared() {  # link_shared <sha> <worktree>: worktreeLinks from the main checkout into the worktree
  local sha="$1" wt="$2" links shared parent top wtreal
  wtreal="$(cd "$wt" && pwd -P)" || fail "cannot resolve the temporary worktree $wt; check the repository: git worktree list"
  links="$(cfg_at "$sha" worktreeLinks)" || exit 1
  while IFS= read -r shared; do
    [ -n "$shared" ] || continue
    case "$shared" in /* | .. | ../* | */../* | */..) fail "worktreeLinks entry '$shared' must be a path inside the repo (no leading / and no '..'); fix it in .claude/gw.json: python3 $config --root $root validate" ;; esac
    shared="${shared%/}"
    [ -n "$shared" ] || continue
    if { [ -e "$root/$shared" ] || [ -L "$root/$shared" ]; } && [ ! -e "$wt/$shared" ] && [ ! -L "$wt/$shared" ]; then
      # A symlink committed in the pushed tree (cache -> /outside) must not make mkdir/ln write outside the worktree:
      # check the deepest existing folder before creating anything, and the parent again once it exists.
      parent="$(dirname "$wt/$shared")"
      top="$parent"
      while [ ! -d "$top" ] && [ "$top" != "$wt" ]; do top="$(dirname "$top")"; done
      if ! { [ -d "$top" ] && case "$(cd "$top" && pwd -P)/" in "$wtreal"/*) true ;; *) false ;; esac; }; then
        fail "worktreeLinks entry '$shared' resolves outside the temporary worktree (a symlink in the pushed tree?); remove it from worktreeLinks in .claude/gw.json: python3 $config --root $root validate"
      fi
      if ! mkdir -p "$parent" || ! case "$(cd "$parent" && pwd -P)/" in "$wtreal"/*) true ;; *) false ;; esac; then
        fail "worktreeLinks entry '$shared' resolves outside the temporary worktree or cannot be created; remove it from worktreeLinks in .claude/gw.json: python3 $config --root $root validate"
      fi
      if ! ln -s "$root/$shared" "$wt/$shared"; then
        fail "cannot link '$shared' into the temporary worktree; check the path or drop it from worktreeLinks in .claude/gw.json: python3 $config --root $root validate"
      fi
    fi
  done <<<"$links"
}
checkdir=""
mark_only_parent() {  # mark_only_parent <sha>: prints the parent's sha when <sha> only adds/edits the reviewMark file on it
  local sha="$1" mark_file parents parent raw expect
  parents="$(git rev-list --parents -n 1 "$sha" 2>/dev/null)" || return 1
  # shellcheck disable=SC2086  # two shas or one or three: split on purpose
  set -- $parents
  [ "$#" -eq 2 ] || return 1  # a root commit or a merge: not a mark commit
  parent="$2"
  # The rule is the parent's, never the pushed commit's own (a commit cannot relax what judges it).
  [ "$(cfg_at "$parent" checkReuseMark 2>/dev/null)" = "true" ] || return 1
  mark_file="$(cfg_at "$parent" reviewMark 2>/dev/null)" || return 1
  [ -n "$mark_file" ] || return 1
  [ "$(git rev-parse "$parent:.claude/gw.json" 2>/dev/null)" = "$(git rev-parse "$sha:.claude/gw.json" 2>/dev/null)" ] || return 1
  raw="$(git -c core.quotePath=false diff-tree -r --no-renames --raw "$parent" "$sha" 2>/dev/null)" || return 1
  [ "$(printf '%s\n' "$raw" | grep -c .)" -eq 1 ] || return 1  # exactly one path changed
  # ":<old mode> <new mode> <old sha> <new sha> <status>\t<path>": the mark file, modified without a mode change, or
  # added as a regular file; anything else (delete, type change, other path) is not exempt.
  printf '%s\n' "$raw" | awk -F'\t' -v want="$mark_file" '
    { split($1, f, " "); old = substr(f[1], 2); new = f[2]; st = f[5]
      if ($2 != want) exit 1
      if (st == "M" && old == new && new ~ /^100(644|755)$/) exit 0
      if (st == "A" && new ~ /^100(644|755)$/) exit 0
      exit 1 }' || return 1
  case "$mark_file" in
    .claude/* | .githooks/* | scripts/* | templates/* | *.sh | *.py | *.json)
      echo "pre-push: reviewMark '$mark_file' is a config, hook or script path, so a commit that edits it is not treated as a review mark; running the check (move the mark to a data file: set reviewMark in .claude/gw.json)" >&2
      return 1 ;;
  esac
  # reviewed.sh writes exactly "<the sha it marks>\n", and that is the parent: any other content is not a review mark.
  expect="$(printf '%s\n' "$parent" | git hash-object --stdin 2>/dev/null)" || return 1
  [ "$(git rev-parse "$sha:$mark_file" 2>/dev/null)" = "$expect" ] || return 1
  printf '%s\n' "$parent"
}
checkout_at() {  # checkout_at <sha>: $checkdir = the project (HEAD clean) or a temporary worktree of that commit
  local sha="$1" dir marker
  if [ -n "$worktree" ]; then
    git worktree remove --force "$worktree" >/dev/null 2>&1; rm -rf "$worktree" "${worktree%.d}"; worktree=""
  fi
  if [ "$sha" = "$(git rev-parse HEAD)" ] && [ -z "$(git status --porcelain)" ]; then
    dir="$root"
  else
    local base common id
    base="$(cfg_at "$sha" worktreeDir)" || exit 1
    [ -n "$base" ] || base="${TMPDIR:-/tmp}"
    case "$base" in /*) ;; *) base="$root/$base" ;; esac
    common="$(cd "$(git rev-parse --git-common-dir)" && pwd)" \
      || fail "cannot find the repository's git dir; check the repository: git rev-parse --git-common-dir"
    id="$(printf '%s' "$common" | cksum | cut -d' ' -f1)"  # one folder per repo (its linked worktrees share it)
    gwdir="${base%/}/gw-pre-push-wt-$(id -u)-$id"  # per user: $TMPDIR is often /tmp, writable by everyone
    [ ! -L "$gwdir" ] || fail "$gwdir is a symlink, not the hook's own folder; remove it and retry: rm $gwdir && git push"
    { [ -d "$gwdir" ] || { mkdir -p "${base%/}" && mkdir -m 700 "$gwdir"; } || [ -d "$gwdir" ]; } || fail "cannot create $gwdir; make it writable or set worktreeDir in .claude/gw.json: python3 $config --root $root validate"
    [ -O "$gwdir" ] || fail "$gwdir belongs to another user; remove it or set worktreeDir in .claude/gw.json: python3 $config --root $root validate"
    stale_worktrees
    marker="$(mktemp "$gwdir/wt.XXXXXX")" || fail "cannot create a temporary worktree in $gwdir; free space or permissions and retry: git push"
    echo "$$" > "$marker"
    worktree="$marker.d"
    git worktree add -q --detach "$worktree" "$sha" >/dev/null 2>&1 \
      || { rm -rf "$worktree" "$marker"; worktree=""; fail "cannot check out ${sha:0:7} in a temporary worktree; clean stale ones and retry: git worktree prune && git push"; }
    link_shared "$sha" "$worktree"
    dir="$worktree"
  fi
  checkdir="$dir"
}
cache_hit() {  # cache_hit <sha>: 0 (and says why) when $key, or the mark-only parent's key, is recorded green; uses run_checks' variables
  local sha="$1"
  if [ -n "$key" ] && age="$(bash "$scripts/check-green.sh" has "$key" 2>/dev/null < /dev/null)"; then
    echo "pre-push: check already green on this tree (${tree:0:7}) with the same commands $age min ago; skipping it (to run it anyway: GW_CHECK_CACHE=0 git push)"
    cache_hits=$((cache_hits + 1))
    return 0
  fi
  # The review-mark commit adds nothing a check sees: the tree it sits on being recorded green is enough.
  if [ -n "$key" ] \
    && parent="$(mark_only_parent "$sha")" && ptree="$(git rev-parse "$parent^{tree}" 2>/dev/null)" \
    && pkey="$(printf '%s\n' "$checks" | bash "$scripts/check-green.sh" key "$ptree" "$wrapper" "$inputs" 2>/dev/null)" \
    && pepoch="$(bash "$scripts/check-green.sh" epoch "$pkey" 2>/dev/null < /dev/null)" \
    && age="$(bash "$scripts/check-green.sh" has "$pkey" 2>/dev/null < /dev/null)"; then
    echo "pre-push: ${sha:0:7} only adds the review mark on ${parent:0:7}, whose tree (${ptree:0:7}) passed this check with the same commands $age min ago; skipping it (to run it anyway: GW_CHECK_CACHE=0 git push)"
    bash "$scripts/check-green.sh" add "$key" "$pepoch" < /dev/null  # green by derivation, as old as its parent's
    cache_hits=$((cache_hits + 1))
    return 0
  fi
  return 1
}
run_checks() {  # run_checks <sha>: every check command on that commit, in $checkdir (kept for related-tests.sh)
  local sha="$1" dir wrapper
  full_runs=$((full_runs + 1))
  wrapper="$(cfg_at "$sha" checkWrapper)" || exit 1
  checkout_at "$sha"
  dir="$checkdir"
  local cmd n=0 lrc kept key="" tree age parent ptree pkey pepoch inputs="" input_paths="" usecache="" lock_wait
  if [ "$is_protected" != "true" ] && [ "${GW_CHECK_CACHE:-}" != "0" ] && [ -f "$scripts/check-green.sh" ]; then
    # Any failure of the helper just means the check runs, as it always did.
    tree="$(git rev-parse "$sha^{tree}" 2>/dev/null)" || tree=""
    # E23: the ignored files the check reads (checkCacheInputs, from the config of the pushed commit) are part of both keys.
    # A list that cannot be read means no key (the check runs), never a key without the inputs.
    if input_paths="$(cfg_at "$sha" checkCacheInputs 2>/dev/null)" && inputs="$(printf '%s\n' "$input_paths" | bash "$scripts/check-green.sh" inputs "$dir" 2>/dev/null)" && [ -n "$tree" ]; then
      key="$(printf '%s\n' "$checks" | bash "$scripts/check-green.sh" key "$tree" "$wrapper" "$inputs" 2>/dev/null)" || key=""
    fi
    usecache=1
    cache_hit "$sha" && return 0
  fi
  if [ -f "$scripts/check-green.sh" ]; then  # one check at a time per repository: check.sh and merge-branch.sh take the same lock
    lock_wait="$(cfg_at "$sha" checkLockWait 2>/dev/null)" || lock_wait=0
    case "$lock_wait" in ''|*[!0-9]*) lock_wait=0 ;; esac
    log="$(mktemp "${TMPDIR:-/tmp}/gw-pre-push-check.XXXXXX")" || fail "cannot create a log file in ${TMPDIR:-/tmp}; free space and retry: git push"
    lrc=0
    bash "$scripts/check-green.sh" lock-acquire "$$" "$sha" "$lock_wait" "$log" < /dev/null || lrc=$?
    if [ "$lrc" -eq 3 ]; then
      rm -f "$log"
      fail "another check holds the lock (above); wait for it and push again: git push, or wait inside the hook: set checkLockWait in .claude/gw.json"
    elif [ "$lrc" -ne 0 ]; then
      rm -f "$log"
      fail "cannot take the check lock (above, exit $lrc); fix that and push again: git push"
    fi
    checklock=1
    # Another check may have recorded this tree green while this push waited for the lock: look again before running.
    if [ -n "$usecache" ] && cache_hit "$sha"; then
      bash "$scripts/check-green.sh" lock-release "$$" < /dev/null 2>/dev/null; checklock=""
      rm -f "$log"; log=""
      return 0
    fi
  fi
  while IFS= read -r cmd; do
    [ -n "$cmd" ] || continue
    n=$((n + 1))
    [ -z "$wrapper" ] || cmd="$wrapper bash -c '$(printf '%s' "$cmd" | sed "s/'/'\\\\''/g")'"
    [ -n "$log" ] || log="$(mktemp "${TMPDIR:-/tmp}/gw-pre-push-check.XXXXXX")" || fail "cannot create a log file in ${TMPDIR:-/tmp}; free space and retry: git push"
    echo "pre-push: check '$cmd' on ${sha:0:7}…"
    if ! (cd "$dir" && GW_PUSH_PROTECTED="$is_protected" bash -c "$cmd") > "$log" 2>&1 < /dev/null; then
      tail -n 30 "$log" >&2
      kept="$log"; log=""  # a failed run keeps its log for the user
      fail "check failed on ${sha:0:7}: '$cmd' (full log: $kept)" "fix it, commit and push again; reproduce with: $cmd"
    fi
    : > "$log"  # the lock names this log: it stays until the last command has passed
  done <<<"$checks"
  [ -z "$log" ] || { rm -f "$log"; log=""; }
  # Run in the project itself (HEAD clean), the check must leave it clean: if it wrote a tracked or untracked file,
  # what it saw is not the pushed tree, so it is not recorded.
  if [ -n "$key" ] && [ "$dir" = "$root" ] && [ -n "$(git status --porcelain)" ]; then
    echo "pre-push: the check left changes in the work tree, so it is not recorded and the next push runs it again; see them with: git status"
    key=""
  fi
  [ -z "$key" ] || bash "$scripts/check-green.sh" add "$key" < /dev/null
}

scan_leftovers() {  # scan_leftovers <sha> <files> <what>: conflict markers and *.rej / *.orig files among <files> in <sha>
  local sha="$1" files="$2" what="$3" leftovers first markers
  leftovers="$(printf '%s\n' "$files" | grep -E '\.(rej|orig)$' | while IFS= read -r f; do
    git cat-file -e "$sha:$f" 2>/dev/null && echo "$f"; done)"
  if [ -n "$leftovers" ]; then
    printf '  %s\n' "$leftovers" >&2
    first="$(printf '%s\n' "$leftovers" | head -n 1)"
    fail "$what adds *.rej / *.orig leftovers (above); remove them and commit: git rm -- '$first' && git commit"
  fi
  markers=""
  [ -z "$files" ] || markers="$(printf '%s\n' "$files" | grep . | tr '\n' '\0' | xargs -0 git grep -n -I -E '^(<<<<<<< |>>>>>>> )' "$sha" -- 2>/dev/null | head -n 10)"
  if [ -n "$markers" ]; then
    printf '  %s\n' "$markers" >&2
    fail "$what has conflict markers (above); resolve them and commit: git commit -a"
  fi
}

checked=""
# Trees this push sends to the protected branch (by the pushed commit's own config): a branch pushed with the same tree
# is still checked with its own scope (related tests run), but repeats no full check: the protected one is stricter
# (GW_PUSH_PROTECTED=true) and runs in this same hook.
protected_trees=""
protected_name=""
while read -r _pre_ref pre_sha pre_remote_ref _pre_rest; do
  { [ -n "${pre_sha:-}" ] && [ "$pre_sha" != "$zero" ]; } || continue
  case "$pre_remote_ref" in refs/tags/*) continue ;; esac
  pre_sha="$(git rev-parse -q --verify "$pre_sha^{commit}" 2>/dev/null)" || continue  # a tag pushed to a branch: its commit
  pre_prot="$(python3 "$config" --root "$root" --rev "$pre_sha" get protectedBranch 2>/dev/null)" || continue
  if [ "$pre_remote_ref" = "refs/heads/$pre_prot" ]; then
    pre_tree="$(git rev-parse "$pre_sha^{tree}" 2>/dev/null)" || continue
    protected_trees="$protected_trees $pre_tree"
    protected_name="$pre_prot"
  fi
done < "$work/input"
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  [ "$local_sha" = "$zero" ] && continue                  # deleting a ref
  case "$remote_ref" in refs/tags/*) continue ;; esac  # a tag sent to a branch is checked like any commit
  local_sha="$(git rev-parse -q --verify "$local_sha^{commit}" 2>/dev/null)" || fail "commit ${local_sha:0:7} is not in this clone; fetch it and retry: git fetch $remote"
  checks="$(cfg_at "$local_sha" check)" || exit 1
  protected="$(cfg_at "$local_sha" protectedBranch)" || exit 1
  files=""  # what this ref's new commits change (set below when it brings any)

  # What this push adds: commits no remote-tracking ref (nor the remote's current tip) already has.
  known=""
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then known="$remote_sha"; fi
  # shellcheck disable=SC2086  # $known is one sha or nothing
  new="$(git rev-list --reverse "$local_sha" --not --remotes $known)" || fail "cannot list the commits of ${local_sha:0:7}; fetch and retry: git fetch $remote"
  if [ -z "$new" ]; then
    if [ "$local_sha" = "$remote_sha" ]; then
      echo "pre-push: nothing new to push to $remote_ref (it is already at ${local_sha:0:7}; did you commit?)"
    elif [ "$remote_sha" = "$zero" ]; then
      echo "pre-push: creating $remote_ref at ${local_sha:0:7}: all its commits are already on the remote"
    elif [ -z "$known" ]; then
      echo "pre-push: moving $remote_ref from ${remote_sha:0:7} to ${local_sha:0:7}; ${remote_sha:0:7} is not in this clone, so the commits it gains or loses cannot be counted (git fetch $remote to see them)"
    else
      # The ref moves to commits the remote already has: forward (work branch -> main), back (a rewind) or sideways
      # (a force push to another branch's tip). Warn about what leaves, do not block; the protected-branch rules
      # below still apply.
      gained="$(git rev-list --count "$known..$local_sha")" || fail "cannot count the commits between ${known:0:7} and ${local_sha:0:7}; fetch and retry: git fetch $remote"
      dropped="$(git rev-list --count "$local_sha..$known")" || fail "cannot count the commits between ${local_sha:0:7} and ${known:0:7}; fetch and retry: git fetch $remote"
      if [ "$gained" -gt 0 ]; then
        echo "pre-push: moving $remote_ref to ${local_sha:0:7}: $gained commit(s) it gains, already on the remote in other branches"
      fi
      if [ "$dropped" -gt 0 ]; then
        if [ "$gained" -gt 0 ]; then how="moving $remote_ref sideways"; else how="rewinding $remote_ref"; fi
        echo "pre-push: WARNING: $how from ${known:0:7} to ${local_sha:0:7}: $dropped commit(s) leave this branch"
      fi
    fi
  else
    count="$(printf '%s\n' "$new" | grep -c .)"
    echo "pre-push: pushing $count commit(s) to $remote_ref:"
    # shellcheck disable=SC2086  # one sha per word
    git log --no-walk=unsorted --format='  %h %s' $new | head -n 20
    [ "$count" -gt 20 ] && echo "  … and $((count - 20)) more"
    printf '%s\n' "$new" >> "$work/pushed"
    # shellcheck disable=SC2086
    files="$(git log -m --format= --name-only --no-renames "$local_sha" --not --remotes $known | sort -u)"
    printf '%s\n' "$files" | grep . >> "$work/changed"

    scan_leftovers "$local_sha" "$files" "the push"
    if [ -f "$scripts/private-check.py" ]; then  # an older project without it: skipped, like the optional scripts
      pc_rc=0
      printf '%s\n' "$new" | python3 "$scripts/private-check.py" --root "$root" --rev "$local_sha" --base "$known" --remote "$remote" --ref "${local_ref#refs/heads/}" --commits - || pc_rc=$?
      if [ "$pc_rc" = 1 ]; then
        fail "the push carries private data or a key (above); those commits are not pushed yet: fix only them with the command above, then push again"
      elif [ "$pc_rc" != 0 ]; then
        fail "private-check could not run, exit $pc_rc (above); fix that and push again, reproduce with: python3 $scripts/private-check.py --root $root --commits - --rev ${local_sha:0:7}"
      fi
    fi
  fi

  # Protected if any config names this branch: the pushed commit's, the remote tip's or the working tree's (a commit
  # that renames protectedBranch must not unprotect the branch it is pushed to).
  branch="${remote_ref#refs/heads/}"
  is_protected=false
  [ "$remote_ref" = "refs/heads/$protected" ] && is_protected=true
  if [ "$remote_sha" != "$zero" ] && [ "$branch" != "$remote_ref" ]; then
    git cat-file -e "$remote_sha^{commit}" 2>/dev/null || git fetch -q "$remote" "$branch" >/dev/null 2>&1
    if git cat-file -e "$remote_sha:.claude/gw.json" 2>/dev/null; then
      # An invalid config there (a WIP: commit pushed with --no-verify) names no branch: the next push must be able to
      # fix it. The pushed commit's and the working tree's configs still count, and a protected tip is judged below.
      if remote_protected="$(python3 "$config" --root "$root" --rev "$remote_sha" get protectedBranch 2>/dev/null)"; then
        [ "$remote_protected" = "$branch" ] && is_protected=true
      else
        echo "pre-push: WARNING: the .claude/gw.json of $remote_ref's tip (${remote_sha:0:7}) is invalid; this push can fix it"
      fi
    fi
  fi
  wt_protected="$(python3 "$config" --root "$root" get protectedBranch 2>/dev/null)" || wt_protected=""
  [ -n "$wt_protected" ] && [ "$remote_ref" = "refs/heads/$wt_protected" ] && is_protected=true
  this_tree="$(git rev-parse "$local_sha^{tree}" 2>/dev/null)" || this_tree=""
  if [ "$checked" != "$local_sha:$is_protected" ]; then
    scope="full"
    if [ "$is_protected" != "true" ]; then  # D49: a branch push runs only relatedTests unless the environment changes
      if [ -z "$new" ] && [ "$local_sha" != "$remote_sha" ]; then
        # The ref moves (created or moved onto commits the remote already has) with no new commits to take files from.
        scope="full no new commits to scope the related tests"
      else
        printf '%s\n' "$new" > "$work/new_ref"  # E47: a .claude/gw.json change counts by the keys these commits change
        scope="$(printf '%s\n' "$files" | python3 "$config" --root "$root" --rev "$local_sha" push-scope --commits "$work/new_ref")" \
          || fail "cannot tell which check this push needs; fix the config and push again: python3 $config --root $root --rev ${local_sha:0:7} validate"
      fi
    fi
    case "$scope" in
      related)
        echo "pre-push: ${local_sha:0:7} goes to a branch: only its related tests run (branchCheck); the full check runs on the push to $protected and when the environment changes (to run it now: bash $scripts/check.sh)"
        checkout_at "$local_sha"
        # This ref's own files on this ref's own tree (the call after the loop only sees the last checkout).
        if [ -f "$scripts/related-tests.sh" ] && [ -n "$checkdir" ]; then
          printf '%s\n' "$files" | grep . > "$work/changed_ref"
          bash "$scripts/related-tests.sh" "$work/changed_ref" "$checkdir" < "$work/input" || fail "the related tests failed; fix them, commit and push again: git push"
        fi ;;
      full*)
        [ "$is_protected" = "true" ] || [ "$scope" = "full" ] || echo "pre-push: full check on ${local_sha:0:7}: ${scope#full }"
        printf '%s\n' "$files" | grep . >> "$work/changed_full"
        full_ref=true
        if [ "$is_protected" != "true" ] && [ -n "$this_tree" ] && case " $protected_trees " in *" $this_tree "*) true ;; *) false ;; esac; then
          echo "pre-push: ${local_sha:0:7} has the tree (${this_tree:0:7}) this push also sends to $protected_name; its full check runs once, there"
        else
          run_checks "$local_sha"
        fi ;;
      *) fail "unexpected answer from config.py push-scope: '$scope'; reinstall the workflow scripts: /gw-update" ;;
    esac
    checked="$local_sha:$is_protected"
  fi

  # To the protected branch: code must be reviewed up to the mark, whatever pushToProtected says (a direct push
  # skips the PR hook that guards the `pr` mode).
  if [ "$is_protected" = "true" ]; then
    protected="$branch"
    base=""
    policy="$local_sha"
    if [ "$remote_sha" != "$zero" ]; then
      git cat-file -e "$remote_sha^{commit}" 2>/dev/null || git fetch -q "$remote" "$protected" >/dev/null 2>&1
      git cat-file -e "$remote_sha^{commit}" 2>/dev/null \
        || fail "the remote $protected is at ${remote_sha:0:7}, which this clone does not have; fetch it and push again: $(fetch_hint)"
      base="$remote_sha"
    fi
    # Everything the protected branch gains, not only what no remote has yet: a commit already pushed to another
    # branch (a task that publishes with git push origin <branch>:main) skips the scan above.
    if [ -n "$base" ]; then
      gains="$(git diff --name-only --no-renames "$base" "$local_sha")" || fail "cannot list what ${local_sha:0:7} changes from ${base:0:7}; fetch and retry: $(fetch_hint)"
    else
      gains="$(git ls-tree -r --name-only "$local_sha")" || fail "cannot list the files of ${local_sha:0:7}; fetch and retry: git fetch $remote"
    fi
    scan_leftovers "$local_sha" "$gains" "this push to $protected"
    if [ -n "$base" ] && git cat-file -e "$base:.claude/gw.json" 2>/dev/null; then
      policy="$base"  # an invalid config there fails closed in cfg_at
    else
      echo "pre-push: WARNING: $protected has no .claude/gw.json on the remote yet; judging this push by the pushed commit's config"
    fi
    mark_file="$(cfg_at "$policy" reviewMark "$local_sha")" || exit 1
    code="$(bash "$scripts/is-code.sh" --rev "$policy" "$base" "$local_sha")" || fail "cannot tell code from content; fix the error above and push again: $(fetch_hint)"
    if [ -n "$code" ]; then
      mark="$(git show "$local_sha:$mark_file" 2>/dev/null | tr -d '[:space:]')"
      reason=""
      if [ -z "$mark" ]; then
        reason="the pushed commit has no review mark ($mark_file)"
      elif ! git rev-parse -q --verify "$mark^{commit}" >/dev/null 2>&1; then
        reason="the review mark ($mark_file) names ${mark:0:12}, which is not a commit in this clone"
      elif ! git merge-base --is-ancestor "$mark" "$local_sha" 2>/dev/null; then
        reason="the review mark (${mark:0:7}) is not an ancestor of ${local_sha:0:7}"
      else
        after="$(bash "$scripts/is-code.sh" --rev "$policy" "$mark" "$local_sha")" || fail "cannot tell code from content; fix the error above and push again: $(fetch_hint)"
        [ -z "$after" ] || { reason="code changed after the review mark (${mark:0:7})"; code="$after"; }
      fi
      if [ -n "$reason" ]; then
        printf '%s\n' "$code" | head -n 10 | sed 's/^/  /' >&2
        if [ "$shallow" = "true" ]; then
          fail "$reason; this push to $protected brings unreviewed code (above)." \
               "this clone is shallow, so the mark may be beyond its history; deepen it and push again: $(fetch_hint)"
        fi
        fail "$reason; this push to $protected brings unreviewed code (above)." \
             "run /code-review of the diff against $remote/$protected, push the fixes, then mark and push: bash $scripts/reviewed.sh && git push"
      fi
    fi
  fi
done < "$work/input"

# Hook points for the optional per-project scripts, with git's ref lines on stdin. Present means run (with bash, so
# a lost exec bit cannot switch a check off).
sort -u -o "$work/changed" "$work/changed"
if [ -f "$scripts/prepush-branches.sh" ]; then
  bash "$scripts/prepush-branches.sh" "$work/changed" "$work/pushed" < "$work/input" || fail "prepush-branches.sh refused the push; fix what it reports and push again: git push"
fi
related_kinds="fast slow"
if [ "$full_ref" = "true" ] && [ "$full_runs" -gt 0 ] && [ "$cache_hits" -eq "$full_runs" ]; then
  # B33: every full-scope ref passed the whole check on this very tree (cache), which already covers the fast related
  # tests; the slow ones (what the check does not run) still run.
  echo "pre-push: related tests skipped: the full check is already green on this tree in cache and covers them; only relatedTests.slow run (to run all: GW_CHECK_CACHE=0 git push)"
  related_kinds="slow"
fi
if [ -f "$scripts/related-tests.sh" ] && [ -n "$checkdir" ] && [ "$full_ref" = "true" ]; then
  sort -u -o "$work/changed_full" "$work/changed_full"
  GW_RELATED_KINDS="$related_kinds" bash "$scripts/related-tests.sh" "$work/changed_full" "$checkdir" < "$work/input" || fail "the related tests failed; fix them, commit and push again: git push"
fi
echo "pre-push: all green."
